# Copy to .env.local (Vercel: set the same keys in Project Settings → Environment Variables)

# --- Existing (unchanged) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_PRO=

# --- New: Web Push (PWA) ---
# Generate once with: npx web-push generate-vapid-keys
# Public key is safe to expose (NEXT_PUBLIC_*); private key is server/
# Edge-Function-only and must never be committed or sent to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- New: Reminder engine cron (app/api/cron/reminders) ---
# Any long random string. Vercel automatically sends this as
# `Authorization: Bearer <value>` when it invokes a scheduled cron job
# (see vercel.json) — set the SAME value here and in Vercel's Project
# Settings → Environment Variables. The primary scheduler is actually
# pg_cron running inside Postgres (see migration 0024) — this route is
# a secondary/manual trigger, but still needs its own secret since it's
# a privileged, cross-workspace endpoint.
CRON_SECRET=

# --- New: Cloudflare Turnstile (public lead-form bot protection) ---
# Free, no request cap for this use case — create a site at
# https://dash.cloudflare.com/?to=/:account/turnstile. Public site key
# is safe to expose; secret key is server-only. Leaving both empty
# keeps the form working exactly as before (honeypot + rate limit only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- New: Transactional email (Resend free tier) ---
# Free tier covers low-volume transactional email (team invites, new-
# lead/plan-expiry notification emails). Create a key at
# https://resend.com/api-keys. Leaving this empty keeps every email
# code path a no-op (invites remain link-only, exactly as before).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# --- New: AI-assisted follow-up message drafts (optional, genuinely FREE) ---
# Both of these are free tiers with no credit card required. Leave
# both empty and the "اقترح رسالة متابعة" button still works — it
# falls back to a rule-based offline draft with zero setup.
#
# Gemini (recommended, tried first): free key, no card, ~250-1000
# requests/day depending on model — get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (tried second, if Gemini isn't configured or its call fails):
# free key, no card, ~14,400 requests/day, very fast — get one at
# https://console.groq.com/keys
GROQ_API_KEY=

